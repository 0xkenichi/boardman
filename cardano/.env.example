# Blockfrost API key — get from https://blockfrost.io (select "Cardano Preview Testnet")
BLOCKFROST_PROJECT_ID=your_blockfrost_api_key_here

# Cardano Preview testnet
CARDANO_NETWORK=preview
BLOCKFROST_BASE_URL=https://cardano-preview.blockfrost.io/api/v0

# Boardman wallet mnemonic (24 words) — generated by setup_wallet.js
# NEVER commit this to git
WALLET_MNEMONIC=

# Fee recipient (Boardman treasury on Cardano)
FEE_RECIPIENT_ADDRESS=addr_test1...
