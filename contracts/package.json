  "description": "BoardmanEscrow (V1) for Boardman by sideQuest — ClawEscrow is V0 archive",
  "type": "module",
  "scripts": {
    "deploy:spectator:arc": "hardhat run scripts/deploy_spectator_pool.js --network arcTestnet",
