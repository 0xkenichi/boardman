# Copy to .env and fill in values:
#   cp .env.example .env

# Telegram — Boardman bot (preferred)
TELEGRAM_BOT_TOKEN_BOARDMAN=
TELEGRAM_BOT_USERNAME_MYBOARDMAN=myboardmanOfficialBot
TELEGRAM_BOT_TOKEN=
# Legacy aliases (still work; prefer Boardman names above)
TELEGRAM_BOT_TOKEN_CLAWSTATION=
TELEGRAM_BOT_USERNAME_CLAWSTATION=myboardmanOfficialBot
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=myboardmanOfficialBot
NEXT_PUBLIC_TELEGRAM_BOT_URL=https://t.me/myboardmanOfficialBot

# Supabase
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# External football API keys (do NOT commit real keys)
# Option A: API-Football (recommended) — weekly AFM oracle
#   python -m gaming.src.stack.agentic.football.weekly_oracle
API_FOOTBALL_KEY=
API_FOOTBALL_SEASON=

# Option B: RapidAPI proxy
RAPIDAPI_KEY=
RAPIDAPI_HOST=
RAPIDAPI_BASE=

# Lichess gym — one BOT token per agent (never share). Linked to Boardman wallet/identity.
# Token needs bot:play. Do not commit real values.
LICHESS_RAJA_API_TOKEN=
RAJA_LICHESS_USER=myrajafromboardman
LICHESS_NERO_API_TOKEN=
NERO_LICHESS_USER=keniichii

# Circle (required for wallets / escrow)
CIRCLE_API_KEY=
CIRCLE_CLIENT_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=

# Circle webhooks (inbound deposit credits). REQUIRED — the /webhooks/circle
# endpoint is fail-closed: without CIRCLE_WEBHOOK_SECRET every request is
# rejected with 401. Set the SAME secret in the Circle dashboard → Webhooks.
CIRCLE_WEBHOOK_SECRET=
# Local dev only: set 1 to skip signature verification when the secret is absent.
# CIRCLE_WEBHOOK_SKIP_VERIFY=1

# Short match codes (display refs). Optional — if unset, a random secret is
# generated once and persisted to data/match_code_secret (gitignored).
# MATCH_CODE_SECRET=

# Boardman V1 dedicated wallet (ops + platform fee + resolver until split)
BOARDMAN_OPS_USDC_ADDRESS=0xFA931C535C9d10A324Ea7417a63ed22dD9b0cb2E
BOARDMAN_FEE_RECIPIENT=0xFA931C535C9d10A324Ea7417a63ed22dD9b0cb2E
FEE_RECIPIENT_ADDRESS=0xFA931C535C9d10A324Ea7417a63ed22dD9b0cb2E
RESOLVER_ADDRESS=0xFA931C535C9d10A324Ea7417a63ed22dD9b0cb2E

# Multi-rail funding (Path A) — stakes ALWAYS settle on Arc play wallet
# Full guide: docs/OPS_WHAT_WE_NEED.md
BOARDMAN_SETTLEMENT_RAIL=arc
BOARDMAN_URL=https://boardman.playingsidequest.fun
REMATCH_LEADERBOARD_URL=https://boardman.playingsidequest.fun/leaderboard

# Stellar USDC ops receive (G... public key ONLY — never secret S...)
BOARDMAN_OPS_USDC_STELLAR=FILL_ME_G_PUBLIC_KEY
BOARDMAN_STELLAR_MEMO_PREFIX=BM
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=
STELLAR_WATCH_ENABLED=1
STELLAR_WATCH_STATE_FILE=
STELLAR_SHOW_ALWAYS=1
STELLAR_ACCEPT_ANY_ASSET=0
STELLAR_USDC_ISSUER=
FUNDING_RAIL_WATCH_SEC=90

# Avalanche funding (0x). Empty BOARDMAN_OPS_USDC_AVALANCHE → uses BOARDMAN_OPS_USDC_ADDRESS
BOARDMAN_OPS_USDC_AVALANCHE=
AVALANCHE_NETWORK=fuji
AVALANCHE_USDC_ADDRESS=0x5425890298aed601595a70AB815c96711a31Bc65
AVALANCHE_WATCH_ENABLED=0
AVALANCHE_FUJI_RPC_URL=
CLAW_ESCROW_ADDRESS_AVALANCHE=
CIRCLE_USDC_TOKEN_ID_AVALANCHE=
ARC_TESTNET_RPC_URL=
BASE_SEPOLIA_RPC_URL=

# Local runtime
CLAWSTATION_BOT_MODE=polling
CLAW_DEFAULT_CHAIN=arc
CLAW_MAX_STAKE_USDC=25
CLAW_MAX_WITHDRAW_USDC=50
CLAW_DAILY_WITHDRAW_CAP_USDC=100
CLAW_PAUSED=0
CLAW_ADMIN_TELEGRAM_IDS=FILL_ME_comma_separated_telegram_user_ids
WALLET_WATCH_INTERVAL_SEC=120
LOG_LEVEL=INFO
PORT=8000
NETWORK=testnet
REMATCH_WEB_URL=https://boardman.playingsidequest.fun
BLOCKED_REGIONS_FILE=config/blocked_regions.json

# Tournament cups (Model A entry pool)
# Dry-run seats: TOURNAMENTS_MONEY_LIVE=0 (default)
# Live entries: set LIVE=1 + pot address; pot wallet id for auto refund/payout
TOURNAMENTS_ENABLED=1
TOURNAMENTS_MONEY_LIVE=0
TOURNAMENT_MONEY_MODE=transfer
# transfer = Circle player → pot; commit = balance check only (ops settles)
TOURNAMENT_POT_ADDRESS=
# defaults to BOARDMAN_OPS_USDC_ADDRESS when empty
TOURNAMENT_POT_WALLET_ID=
# Circle wallet id that holds the pot (required for auto refund + prize payout)

# Kobox partner — preferred self-serve Naira ↔ USDC + bank cash-out
KOBOX_ENABLED=1
KOBOX_PARTNER_NAME=Kobox
KOBOX_REFERRAL_URL=FILL_ME
KOBOX_SIGNUP_URL=FILL_ME
KOBOX_APP_URL=FILL_ME
KOBOX_HELP_URL=FILL_ME

# Paystack (Naira collections — preferred automated path)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_DEFAULT_EMAIL=FILL_ME_ops@yourdomain.com
PAYSTACK_CALLBACK_URL=https://boardman.playingsidequest.fun/app
PAYSTACK_CREDIT_SLA_MINUTES=30
PAYSTACK_CREDIT_MODE=manual
# Webhook URL to set in Paystack dashboard:
#   https://boardman.playingsidequest.fun/api/rematch/paystack/webhook
# Also set PAYSTACK_SECRET_KEY + TELEGRAM_BOT_TOKEN + CLAW_ADMIN_TELEGRAM_IDS on Vercel

# Fiat top-up (bank → ops credits USDC) — fallback if user skips Kobox
# Naira collection account
FIAT_NGN_BANK_NAME=
FIAT_NGN_ACCOUNT_NAME=
FIAT_NGN_ACCOUNT_NUMBER=
FIAT_NGN_BANK_NOTE=
# USD / ACH collection (optional)
FIAT_USD_BANK_NAME=
FIAT_USD_ACCOUNT_NAME=
FIAT_USD_ACCOUNT_NUMBER=
FIAT_USD_ACCOUNT_TYPE=Checking
FIAT_USD_ACH_ROUTING=
FIAT_USD_WIRE_ROUTING=
FIAT_USD_BANK_ADDRESS=
FIAT_USD_BANK_NOTE=
# Pricing: on-ramp (user buys USDC) > off-ramp (user sells USDC) — bid/ask
# Real convert cost ~1400; on-ramp 1520 / off-ramp 1500 is the product default
FIAT_NGN_PER_USD=1520
FIAT_NGN_OFFRAMP_PER_USD=1500
FIAT_FEE_FLOOR_USDC=2
FIAT_FEE_PCT=0.05
FIAT_MIN_NGN=5000
FIAT_MAX_NGN=200000
FIAT_MIN_USD=5
FIAT_MAX_USD=200
FIAT_MIN_CREDIT_USDC=1
FIAT_MAX_CREDIT_USDC=100

# Boardman Stack API keys (product name = Boardman; REMATCH_* names still work)
# YOU generate keys for builders — see docs/developers/09-api-keys.md
#   python3 scripts/issue_stack_api_key.py --builder acme_lab
#
# Master key (you / Next.js BFF → gaming API):
BOARDMAN_API_KEY=
# On the Next.js web host only (BFF → API base URL):
# BOARDMAN_API_URL=https://your-gaming-api.example
#
# Legacy names (same values; do not need both):
# REMATCH_API_KEY=
# REMATCH_API_URL=
# STACK_API_KEY=
# STACK_API_URL=
#
# Third-party builders (comma-separated secret:builder_id):
# BOARDMAN_STACK_API_KEYS=sk_bm_acme_...:acme_lab,sk_bm_bob_...:bob_forge
# Or file (chmod 600), one secret:builder_id per line:
# BOARDMAN_STACK_API_KEYS_FILE=/secure/boardman_stack_keys.txt
#
# Local demo only (never production):
# BOARDMAN_STACK_ALLOW_OPEN=1

# Community group invite
REMATCH_TELEGRAM_GROUP_URL=https://t.me/+4YrgJ6vO2h8zMjk0
NEXT_PUBLIC_TELEGRAM_GROUP_URL=https://t.me/+4YrgJ6vO2h8zMjk0


# ── Per-agent LLM keys (chess teaching / strategy) ─────────────────
# Each agent should have its OWN key so Nero and Raja do not share a brain.
# Free keys — no Arc gas required for thinking.
#
# ASI:One — https://asi1.ai / https://docs.asi1.ai
ASI_ONE_API_KEY_NERO=
ASI_ONE_API_KEY_RAJA=
# Shared fallback (only agents on BOARDMAN_LLM_AGENTS may use it):
# ASI_ONE_API_KEY=
ASI_ONE_BASE_URL=https://api.asi1.ai/v1
ASI_ONE_MODEL=asi1-mini
BOARDMAN_ASI_TIMEOUT_SEC=25
BOARDMAN_ASI_FALLBACK_SF=1
#
# Gemini (Google AI Studio) — https://aistudio.google.com/apikey
GEMINI_API_KEY_NERO=
GEMINI_API_KEY_RAJA=
# Shared fallback:
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
BOARDMAN_GEMINI_TIMEOUT_SEC=25
#
# Who may use shared keys (dedicated keys always enable that agent):
BOARDMAN_LLM_AGENTS=nero,raja
# Legacy alias:
# BOARDMAN_ASI_AGENTS=nero,raja
#
# Reasoner order then Stockfish (applies to all LLM-enabled agents):
BOARDMAN_LLM_REASONERS=asi,gemini
# Legacy alias:
# BOARDMAN_NERO_REASONERS=asi,gemini
#
# Frontend Vercel: set GEMINI_API_KEY_NERO, GEMINI_API_KEY_RAJA (and/or ASI_*)
# so POST /api/agentic/asi-move can call the APIs. Without keys → Stockfish only.
#
# Chess rule book (FIDE) is always injected; illegal moves are always rejected.
# See docs/CHESS_RULE_BOOK.md

# ── Real agent wallets on Arc (not demo ledger alone) ──────────────
# Explicit opt-in. Unset / 0 = demo ledger. Never auto-enabled by a hanging key.
# BOARDMAN_AGENTIC_ONCHAIN=1
#
# Resolver = 32-byte PRIVATE KEY of BoardmanEscrow.resolver (not the 20-byte address).
# It may only sign resolveMatch / cancelMatch after a terminal game result.
# BOARDMAN_RESOLVER_KEY=0x...   # 64 hex chars after 0x — never an address
#
# Faucet is a SEPARATE key. The resolver key cannot ERC-20 transfer.
# BOARDMAN_FUNDER_KEY=0x...   # fund via: python3 scripts/fund_agent_wallets.py
#
# Demo-only: allow JSON ledger if Arc lock/settle fails. Default off.
# BOARDMAN_ALLOW_LEDGER_FALLBACK=0
#
# Optional public House / feeRecipient override (no spend key):
# BOARDMAN_HOUSE_WALLET=0x...
# Agents play/stake as their wallet_address (see data/agentic/agents.json).

# SpectatorPool (separate from BoardmanEscrow). Stay 0 until the pool is
# deployed and arena bets use a live agm_* match_id (never "arena").
# SPECTATOR_ONCHAIN=0
# SPECTATOR_ESCROW_ADDRESS=0x7Dcd347fA916bF93Ad8BF3c1c8e9D17111B5313e
# SPECTATOR_CHAIN=arc
#
# Pre-game betting window (seconds) after lock, then the table auto-starts.
# BOARDMAN_BET_WINDOW_SEC=120
# Close the spectator book after this many plies (~12 full moves = 24).
# BOARDMAN_BOOK_CLOSE_PLIES=24
# Adjudicate long games so tables do not sit forever.
# BOARDMAN_MAX_PLIES=80
