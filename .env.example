# Copy to .env and fill in values:
#   cp .env.example .env

# Telegram
TELEGRAM_BOT_TOKEN_CLAWSTATION=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME_CLAWSTATION=ClawStationOfficialBot

# Supabase
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Circle (required for wallets / escrow)
CIRCLE_API_KEY=
CIRCLE_CLIENT_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=

# Local runtime
CLAWSTATION_BOT_MODE=polling
CLAW_DEFAULT_CHAIN=arc
CLAW_MAX_STAKE_USDC=25
CLAW_MAX_WITHDRAW_USDC=50
CLAW_DAILY_WITHDRAW_CAP_USDC=100
CLAW_PAUSED=0
WALLET_WATCH_INTERVAL_SEC=45
LOG_LEVEL=INFO
PORT=8000
NETWORK=testnet
REMATCH_WEB_URL=https://playingsidequest.fun/rematch
BLOCKED_REGIONS_FILE=config/blocked_regions.json

# Rematch Stack API v1 (builders / non-Telegram clients)
STACK_API_KEY=
