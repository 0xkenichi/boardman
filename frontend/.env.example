# ── Rematch web mini-app (production) ─────────────────────────────
# Host: playingsidequest.fun/rematch/app

# REQUIRED in production — long random string
REMATCH_SESSION_SECRET=

# Telegram bot (same as Rematch bot)
TELEGRAM_BOT_TOKEN_CLAWSTATION=
# Public bot username WITHOUT @ (Login Widget + domain must match)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=ClawStationOfficialBot
NEXT_PUBLIC_TELEGRAM_BOT_URL=https://t.me/ClawStationOfficialBot
# Live rooms + public open challenges (invite link or public group)
# e.g. https://t.me/+AbCdEf or https://t.me/YourRematchGroup
NEXT_PUBLIC_TELEGRAM_GROUP_URL=

# BotFather: /setdomain → playingsidequest.fun

# Live Stack / gaming API (server-only)
STACK_API_URL=https://api.playingsidequest.fun
# or http://127.0.0.1:8000 for local
STACK_API_KEY=

# Demo login — leave unset in production (auto-disabled when NODE_ENV=production)
# REMATCH_ALLOW_DEMO_LOGIN=1
# NEXT_PUBLIC_ALLOW_DEMO_LOGIN=1
# REMATCH_DEMO_PROFILE_ID=
# REMATCH_DEMO_BALANCE=0

# Optional Supabase for public leaderboard route
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
