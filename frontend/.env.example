# ── Rematch web mini-app (production) ─────────────────────────────
# Host: playingsidequest.fun/rematch/app

# REQUIRED in production — long random string
REMATCH_SESSION_SECRET=

# Telegram bot — Boardman (@myboardmanOfficialBot)
TELEGRAM_BOT_TOKEN_BOARDMAN=
# Legacy alias still accepted:
# TELEGRAM_BOT_TOKEN_CLAWSTATION=
# Public bot username WITHOUT @ (Login Widget + domain must match)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=myboardmanOfficialBot
NEXT_PUBLIC_TELEGRAM_BOT_URL=https://t.me/myboardmanOfficialBot
# Live rooms + public open challenges (invite link or public group)
NEXT_PUBLIC_TELEGRAM_GROUP_URL=https://t.me/+4YrgJ6vO2h8zMjk0

# BotFather: /setdomain → playingsidequest.fun

# Live Rematch API (server-only — never expose to the browser)
# Preferred on-brand names:
REMATCH_API_URL=http://127.0.0.1:8000
# or https://your-tunnel.trycloudflare.com / https://rematch-api.fly.dev
REMATCH_API_KEY=

# Legacy aliases (still work):
# STACK_API_URL=
# STACK_API_KEY=

# Demo login — leave unset in production (auto-disabled when NODE_ENV=production)
# REMATCH_ALLOW_DEMO_LOGIN=1
# NEXT_PUBLIC_ALLOW_DEMO_LOGIN=1
# REMATCH_DEMO_PROFILE_ID=
# REMATCH_DEMO_BALANCE=0

# Optional Supabase for public leaderboard route
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
