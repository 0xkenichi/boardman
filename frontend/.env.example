# Rematch web mini-app (playingsidequest.fun/rematch/app)
#
# Session (required in production)
REMATCH_SESSION_SECRET=long-random-string

# Telegram Login Widget / WebApp verification (same bot as Rematch)
TELEGRAM_BOT_TOKEN_CLAWSTATION=
# or TELEGRAM_BOT_TOKEN=

# Demo login for local dev (auto-on when NODE_ENV !== production)
REMATCH_ALLOW_DEMO_LOGIN=1
REMATCH_DEMO_PROFILE_ID=62440a47-f4fc-4249-a627-46aaa2d039ef
REMATCH_DEMO_BALANCE=12.5

# Live Stack (server-only — never expose to browser)
STACK_API_URL=http://127.0.0.1:8000
STACK_API_KEY=

# Optional: resolve telegram_id → profile UUID
# REMATCH_PROFILE_LOOKUP_URL=http://127.0.0.1:8000/api/...
