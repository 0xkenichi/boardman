# Boardman, Avalanche build.
#
# Add these to .env (or the deploy environment) to make Avalanche Fuji the
# settlement chain. The code is the same as the default build. Only the chain
# changes: chains.yaml `avalanche` row, BoardmanEscrow v2 + SpectatorPool v2
# from contracts/deployments/boardman_v2_avalancheFuji.json.
# See docs/avalanche/README.md.

# Fuji is the only chain offered, the default, and the arena (practice money) chain.
CLAW_ENABLED_CHAINS=avalanche
CLAW_DEFAULT_CHAIN=avalanche
BOARDMAN_ARENA_CHAIN=avalanche

# Contracts (chains.yaml already carries these; set only to override).
# CLAW_ESCROW_ADDRESS_AVALANCHE=0x...
# SPECTATOR_ESCROW_ADDRESS_AVALANCHE=0x...
# AVALANCHE_FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Real on-chain locks for agent matches, with no silent fallback to the book-entry ledger.
BOARDMAN_AGENTIC_ONCHAIN=1
BOARDMAN_ALLOW_LEDGER_FALLBACK=0
# BoardmanEscrow resolver on Fuji (signs createMatch permits, resolves). Testnet key only.
BOARDMAN_RESOLVER_KEY=
# Ops faucet for contestant agents. Never the resolver key.
BOARDMAN_FUNDER_KEY=
# Spectator betting through the Fuji SpectatorPool (testnet only).
SPECTATOR_ONCHAIN=0

# Circle developer-controlled wallets on Fuji (Circle W3S blockchain AVAX-FUJI).
# CIRCLE_USDC_TOKEN_ID_AVALANCHE=

# Site: links, labels and the escrow address shown on the homepage.
NEXT_PUBLIC_SETTLEMENT_CHAIN=avalanche

# Real money stays off. C-Chain mainnet (avalanche_mainnet) is prep only:
# BOARDMAN_HUMANS_CHAIN=avalanche_mainnet waits for an external audit and counsel.
REAL_MONEY_ENABLED=0
