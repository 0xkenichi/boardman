# syntax=docker/dockerfile:1
# Rematch API + Telegram bot for Akash / Fly / any Docker host.
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential gcc libffi-dev libssl-dev curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY src/backend/requirements.txt /app/requirements.txt
RUN python -m venv /app/.venv \
    && /app/.venv/bin/pip install --no-cache-dir --upgrade pip \
    && /app/.venv/bin/pip install --no-cache-dir -r /app/requirements.txt \
    && /app/.venv/bin/pip install --no-cache-dir pyyaml

COPY src /app/src
COPY config /app/config
COPY scripts/run_house_session.py /app/scripts/run_house_session.py
COPY deploy/start_akash.sh /app/deploy/start_akash.sh
COPY deploy/start_akash.py /app/deploy/start_akash.py

RUN mkdir -p /app/gaming \
    && ln -sfn /app/src /app/gaming/src \
    && touch /app/gaming/__init__.py \
    && ln -sfn /app/config /app/gaming/config \
    && ln -sfn /app/src/backend /app/backend \
    && chmod +x /app/deploy/start_akash.sh /app/deploy/start_akash.py \
    && test -f /app/backend/supabase_client.py

RUN groupadd -r rematch && useradd -r -g rematch -d /app rematch \
    && chown -R rematch:rematch /app

USER rematch

ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONPATH=/app
ENV CLAWSTATION_BOT_MODE=polling
ENV PORT=8000
ENV BLOCKED_REGIONS_FILE=/app/config/blocked_regions.json

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=5 \
    CMD curl -f http://localhost:8000/api/healthz || curl -f http://localhost:8000/ || exit 1

CMD ["python", "/app/deploy/start_akash.py"]
